# PhishScope AI Environment Variables

# LLM Configuration (required for AI explanations)
GEMINI_API_KEY=your_gemini_key_here
# Optional overrides — comma-separated fallbacks tried if primary fails
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_FALLBACKS=gemini-2.5-flash-lite,gemini-flash-latest,gemini-3.1-flash-lite

# Backend Config
PROJECT_NAME="PhishScope AI"
API_V1_STR="/api/v1"
SECRET_KEY=yoursecretkeyhere
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# Database
DATABASE_URL="sqlite:///./phishscope.db"

# ML Config
MODEL_PATH="app/models/phish_model.joblib"
DATASET_PATH="datasets/phishing_dataset.csv"
